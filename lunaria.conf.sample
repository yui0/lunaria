# lunaria.conf — settings that belong to this installation rather than to one
# run. Copy to `lunaria.conf` in the directory you start the launcher from.
# Select another file with --config FILE or LUNARIA_CONF=/path/lunaria.conf.
# Relative paths refer to the startup directory. `NAME=value`, `#` comments; only
# LUNARIA_* names are read.  A variable already set in the environment wins, so
#     LUNARIA_DEVICE=pixel7 ./lunaria-apk.sh game.apk
# still overrides the file for that one run.

# ---------------------------------------------------------------------------
# Which device the emulator reports itself as.
#
# ro.product.model, ro.product.device, ro.board.platform, ro.hardware, the
# build id and the fingerprint all have to describe one machine that was
# actually built, and the platform level has to be one that machine shipped
# with.  Each profile below is a real retail device, copied out of its getprop;
# selecting one sets all of those together, including Build.VERSION.SDK_INT.
#
#   pixel6     Google Pixel 6      (gs101,      Android 12)   <- default
#   pixel7     Google Pixel 7      (gs201,      Android 13)
#   galaxys21  Samsung SM-G991B    (exynos2100, Android 12)
#   lunaria    the emulator's own identity — names no device that exists
#
#LUNARIA_DEVICE=pixel6

# Individual fields, if you need a device that is not in the table.  Anything
# left unset keeps the selected profile's value; the build id, Build.DISPLAY
# and the fingerprint are assembled from whatever these finally say, so they
# cannot end up disagreeing with each other.
#LUNARIA_DEVICE_MANUFACTURER=Google
#LUNARIA_DEVICE_BRAND=google
#LUNARIA_DEVICE_MODEL=Pixel 6
#LUNARIA_DEVICE_NAME=oriole
#LUNARIA_DEVICE_DEVICE=oriole
#LUNARIA_DEVICE_BOARD=oriole
#LUNARIA_DEVICE_PLATFORM=gs101
#LUNARIA_DEVICE_HARDWARE=oriole
#LUNARIA_DEVICE_BUILD_ID=SQ3A.220705.003.A1
#LUNARIA_DEVICE_INCREMENTAL=8672226
#LUNARIA_DEVICE_SECURITY_PATCH=2022-07-05

# The platform level.  Unset, it is the one the chosen device shipped with.
#LUNARIA_SDK_INT=31

# ---------------------------------------------------------------------------
# Where the guest's own files live (its /data and /storage).  Unset, it is the
# directory the launcher was started from.
#
# Set it, and keep it set: this is the one thing the launcher cannot recreate.
# Cross Worlds downloads 13.7 GB into it on first run, and a later run pointed
# somewhere else does not find any of that -- it downloads the lot again.  It
# also wants a path whose components are ASCII, because a guest that mishandles
# one then fails for a reason that has nothing to do with the guest.
# --data-root DIR overrides this setting for one launch. Examples:
#LUNARIA_DATA_ROOT=/mnt/games/lunaria
#LUNARIA_DATA_ROOT=/Volumes/Games/lunaria
#LUNARIA_DATA_ROOT=D:/Games/Lunaria
#LUNARIA_DATA_ROOT="../Game data"

# Unpacked APKs are reusable package data. The default is cache/packages under
# the common data root selected at startup (or the startup directory itself).
# Move the package cache independently, including when each package has its
# own data root in a [package.name] block:
#LUNARIA_CACHE_DIR=D:/Games/Lunaria/cache/packages

# ---------------------------------------------------------------------------
# The screen.
#
# With neither LUNARIA_SCALE nor a LUNARIA_DEVICE_SCREEN_* override set, the
# surface defaults to 1024x768 @ 320 dpi (768x1024 in portrait) -- a size an
# operator can actually use on a desktop, at a density that keeps dp layout
# correct (512x384 dp, Android's "normal" screen-size bucket).
#
# Naming LUNARIA_SCALE switches to scaling the selected device's own panel
# (Pixel 6: 1080x2400 at 420 dpi) instead, the way `wm size` and `wm density`
# do on a device: the app's android:screenOrientation decides which way up it
# is, and the pixels and the density scale together so dp-based layout still
# comes out right.
#
#   0.3   three tenths of the device's screen  (720x324 @ 126dpi landscape)
#   0.5   half the device's screen
#   1     the panel at its true size
#
#LUNARIA_SCALE=0.3

# An exact surface instead of the default or a fraction of the device's.
# These are pixels only; the density has its own setting below, so asking for
# a window size does not silently restate what kind of screen this is.
#LUNARIA_WIDTH=1024
#LUNARIA_HEIGHT=768
# Keep the Android display fixed and fit it into the resized host window.
# Requires the compositor; otherwise resizing changes the Android surface.
#LUNARIA_RESIZE_MODE=scale
#LUNARIA_DPI=420

# A panel that is not the selected device's (portrait, short side first).
#LUNARIA_DEVICE_SCREEN_WIDTH=1080
#LUNARIA_DEVICE_SCREEN_HEIGHT=2400
#LUNARIA_DEVICE_SCREEN_DENSITY=420

# Android hardware reports (memory in MiB). These do not reserve host RAM.
#LUNARIA_MEM_TOTAL_MB=6144
#LUNARIA_CPU_COUNT=4

# Execution engines for the A64 scheduler.
#LUNARIA_A64_ENGINES=4

# ---------------------------------------------------------------------------
# The installed-package ledger this device reports.
#
# PackageManager (getInstalledPackages / getPackageInfo) and the device shell's
# `pm list packages` both answer from it, so they can never disagree.  A device
# has never had an empty one: an app that targets API 30+ sees itself, whatever
# its <queries> names, and the force-queryable set -- which on a Google device
# includes the Play Store and Play services.  Reporting only the caller (which
# every enumerating loop skips) is what makes Play Core answer
# PLAY_STORE_NOT_FOUND and a security SDK call the environment unsupported.
#
#   default   the built-in ledger for a Pixel-class Google device  <- default
#   none      only the running app (no device is like this; bisect only)
#   <path>    a ledger file of your own
#
#LUNARIA_PACKAGES=default

# A ledger file, and this setting, are lines of
#
#     <package> [uid] [flags] [sourceDir]
#
# with `#` comments.  flags is a comma-separated subset of
#   system      ApplicationInfo.FLAG_SYSTEM
#   queryable   <application android:forceQueryable="true"> -- visible to any
#               app with no <queries> entry and no QUERY_ALL_PACKAGES
#   updated     FLAG_UPDATED_SYSTEM_APP
# Everything after the package name may be left off, so a bare name is an
# ordinary installed app.  Separate several with ',' or ';'.  Each entry's
# sourceDir is created on the guest filesystem as an empty (but well-formed)
# zip, because `pm list packages -f` prints that path and an app may open it.
#
#LUNARIA_PACKAGES_EXTRA=com.facebook.katana;com.instagram.android

# LUNARIA_TRACE_PM=1 prints the ledger as it was built.

# -- WebView ------------------------------------------------------------------
# What renders android.webkit.WebView.  Both engines are driven over the same
# DevTools pipe; the page is shown as a captured image inside the view.
#
#   auto    an installed Chrome/Chromium, else luna-browser    <- default
#   chrome  Chrome/Chromium only
#   luna    luna-browser (luna-ui + QuickJS; `make luna-browser`)
#   off     no engine: loads fail (onReceivedError, then onPageFinished)
#
#LUNARIA_WEB_ENGINE=auto
# A browser binary by path (not a shell wrapper); overrides auto/chrome/luna.
#LUNARIA_WEB_BROWSER=/opt/google/chrome/chrome

# ---------------------------------------------------------------------------
# Right-click menu (settings, resolution, sound, WebView, keyboard, full screen).
# Resolution changes immediately and is saved; other settings apply on restart.
# Cancel discards edits in the settings dialog.
# Resolution presets: 800x450, 1024x576, 1280x720, 1600x900, 1920x1080,
# 1024x768, rotated for portrait windows. Pixel size and DPI are independent.
#
# A line above the first [package] block is common: it applies to every app
# and it wins over the same name inside a package block.  The menu writes the
# change into that app's block, so the next launch of the same APK picks it
# up wherever the common lines left the name unset.  Package blocks come after
# the common lines.  A name already set in the environment still wins over both.
#
#   LUNARIA_ALSA_DEVICE    sound output (an ALSA PCM name, or off)
#   LUNARIA_AUDIO_VOLUME   0..1
#   LUNARIA_AUDIO_MUTE     1 mutes
#   LUNARIA_WEB_ENGINE     auto / chrome / luna / off
#   LUNARIA_WEB_ZOOM       CSS pixels per view pixel; omit to follow density
#   LUNARIA_KEYMAP         a keymap file, or off
#   LUNARIA_FULLSCREEN     1 starts in full screen
#
# [com.miHoYo.GenshinImpact]
# LUNARIA_KEYMAP=keymaps/genshin.conf
# LUNARIA_PROFILE_PROMPT=1
# LUNARIA_SHARED_ASSETS=AssetBundles:AudioAssets:VideoAssets:UnityShaderBin:il2cpp:ctable.dat:hardware_model_config.json:vulkan_gpu_list_config.txt
# LUNARIA_PROFILE_SEED_FILES=data_revision:data_versions_persist:res_revision:res_revision_eternal:res_versions_persist:silence_data_versions_persist:silence_revision:base_res_version_hash:audio_revision:ScriptVersion:PatchDone:ChannelName:vulkan_gpu_list_config_engine.txt

# Guest graphics API: Vulkan is enabled by default when the host bridge is available.
# Set 0 to expose OpenGL ES only. The right-click Graphics API menu saves
# this choice per app; restart the app to apply. GLES-only apps still use GLES.
# LUNARIA_VULKAN=1
