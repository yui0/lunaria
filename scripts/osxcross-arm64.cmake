set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64)
set(CMAKE_OSX_SYSROOT "$ENV{SDKROOT}")
set(CMAKE_C_COMPILER "$ENV{CC}")
set(CMAKE_CXX_COMPILER "$ENV{CXX}")
set(CMAKE_ASM_COMPILER "$ENV{CC}")
set(CMAKE_OBJC_COMPILER "$ENV{CC}")
set(CMAKE_OBJCXX_COMPILER "$ENV{CXX}")

# Archiver for -flto builds: CMake derives <LANG>_COMPILER_AR from the compiler
# name, which fails for wrapper compilers, so name the LLVM tools explicitly.
if(DEFINED ENV{MAC_AR})
  find_program(_mac_ar NAMES "$ENV{MAC_AR}" llvm-ar REQUIRED)
else()
  find_program(_mac_ar NAMES llvm-ar REQUIRED)
endif()
if(DEFINED ENV{MAC_RANLIB})
  find_program(_mac_ranlib NAMES "$ENV{MAC_RANLIB}" llvm-ranlib REQUIRED)
else()
  find_program(_mac_ranlib NAMES llvm-ranlib REQUIRED)
endif()
set(CMAKE_AR "${_mac_ar}")
set(CMAKE_RANLIB "${_mac_ranlib}")
foreach(_l C CXX ASM OBJC OBJCXX)
  set(CMAKE_${_l}_COMPILER_AR "${_mac_ar}")
  set(CMAKE_${_l}_COMPILER_RANLIB "${_mac_ranlib}")
endforeach()
